<Window x:Class="ValheimControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Server Control"
        Height="520" Width="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Cyberspace Valheim Server"
                       FontSize="20" FontWeight="Bold" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1"
                   Text="Status: Unknown" FontSize="14"
                   Margin="0,4,0,2" Foreground="DarkOrange" />

        <TextBlock x:Name="LastBackupText" Grid.Row="2"
                   Text="Last Backup: (unknown)" FontSize="12"
                   Margin="0,0,0,10" Foreground="Gray" />

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
            <Button x:Name="RestartButton" Content="Restart" Click="RestartButton_Click" />
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" />
            <Button x:Name="BackupButton" Content="Manual Backup" Click="BackupButton_Click" />
            <Button x:Name="BackupRestartButton" Content="Backup + Restart" Click="BackupRestartButton_Click" />
            <Button x:Name="StatusButton" Content="Check Status" Click="StatusButton_Click" />
            <Button x:Name="LogsButton" Content="View Recent Logs" Click="LogsButton_Click" />
        </WrapPanel>

        <TextBox x:Name="LogBox" Grid.Row="4"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 Background="#1E1E1E" Foreground="#DCDCDC"
                 Padding="6" Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
