<Window x:Class="ValheimControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Control"
        Width="1080" Height="820"
        MinWidth="960" MinHeight="720"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Layout mirrors mockup 1a "Carved Longhall".
         All brushes/styles come from Theme/VikingTheme.xaml (merged in App.xaml).
         The native caption bar is darkened by DarkTitleBarHelper.Apply(this) in
         the constructor, so this window draws no chrome of its own. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- brass band + hall header -->
            <RowDefinition Height="*" />      <!-- status/roster + actions -->
            <RowDefinition Height="Auto" />   <!-- saga log -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0">
            <Border Height="4" Background="{StaticResource ChevronBandBrush}" />
            <Border Background="{StaticResource BgTitleBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource MjolnirMarkStyle}" />
                        <TextBlock Text="VALHEIM CONTROL"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AppUpdateButton" Content="APP UPDATE AVAILABLE"
                                Style="{StaticResource ChipButtonStyle}"
                                BorderBrush="{StaticResource StatusWarningBrush}"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Margin="0,0,10,0" Visibility="Collapsed" Click="AppUpdateButton_Click" />
                        <Button x:Name="RefreshButton" Content="&#8635;"
                                Style="{StaticResource ChipButtonStyle}"
                                FontSize="15" Padding="8,4"
                                ToolTip="Refresh all data now"
                                Margin="0,0,10,0" Click="RefreshButton_Click" />
                        <Button x:Name="RunestonesButton" Content="RUNESTONES"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,0" Click="RunestonesButton_Click" />
                        <Button x:Name="UpdateWindowButton" Content="UPDATE"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,0" Click="UpdateWindowButton_Click" />
                        <Button x:Name="SettingsWindowButton" Content="SETTINGS"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,0" Click="SettingsWindowButton_Click" />
                        <Button x:Name="AccountButton" Content="ACCOUNT"
                                Style="{StaticResource ChipButtonStyle}"
                                BorderBrush="{StaticResource AccentGoldBrush}"
                                Margin="0,0,14,0" Click="AccountButton_Click" />
                        <TextBlock x:Name="HostLabel"
                                   Text=""
                                   Style="{StaticResource MonoTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="376" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{StaticResource BorderMutedBrush}" />

            <!-- Left: state + roster (Yggdrasil watermark behind) -->
            <Grid Grid.Column="0">
            <Border Background="{StaticResource YggdrasilWatermarkBrush}"
                    Height="320" VerticalAlignment="Bottom" Margin="40,0,40,0"
                    IsHitTestVisible="False" />
            <StackPanel Margin="22">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="SERVER STATE" Style="{StaticResource StatLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" />
                            <!-- StateText.Foreground is assigned from AppTheme in code. -->
                            <TextBlock x:Name="StateText" Text="UNKNOWN"
                                       Style="{StaticResource StateTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Live - queried from the server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="World" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,11" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,11">
                                <TextBlock x:Name="WorldValue" Text="—" Style="{StaticResource StatValueStyle}"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Button x:Name="SwapWorldQuickButton" Content="SWAP" Style="{StaticResource ChipButtonStyle}"
                                        FontSize="9" Padding="8,3" Margin="8,0,0,0"
                                        ToolTip="Quick-swap to another world" Click="SwapWorldQuickButton_Click" />
                            </StackPanel>

                            <!-- Placeholder - Valheim doesn't expose this without a new backend query; see HANDOFF follow-up -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Uptime" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,11" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UptimeValue" Text="—" Style="{StaticResource StatValueStyle}"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,11" />

                            <!-- Live - queried from the server -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last backup" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,11" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastBackupValue" Text="unknown" Style="{StaticResource StatValueStyle}" Margin="0,0,0,11" />

                            <!-- Live - counts down to the real 30s auto status poll -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Next auto-refresh" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RefreshCountdown" Text="00:30"
                                       Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource AccentGoldBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Roster - placeholder until player-list parsing is built -->
                <Grid Margin="0,20,0,0">
                    <TextBlock Text="JARLS ABOARD" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
                    <TextBlock x:Name="PlayerCount" Text="—" Style="{StaticResource MonoTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="Recent joins since last restart - departures aren't tracked (Valheim doesn't log them reliably)."
                           Style="{StaticResource SubtitleTextStyle}" FontSize="10" Margin="0,2,0,8" />
                <Border Style="{StaticResource DividerStyle}" />

                <Border BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Padding="16">
                    <StackPanel x:Name="PlayerRosterPanel">
                        <TextBlock Text="Checking for recent player activity..." Style="{StaticResource SubtitleTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>

            <!-- Right: actions, three tiers -->
            <StackPanel Grid.Column="2" Margin="22">

                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource SectionAxeStyle}" />
                    <TextBlock Text="SERVER" Style="{StaticResource SectionHeaderStyle}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource DividerStyle}" />
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Button x:Name="StartButton" Content="START" Tag="Raise the hall"
                            Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"
                            Click="StartButton_Click" />
                    <Button x:Name="RestartButton" Content="RESTART" Tag="Cycle the world"
                            Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0"
                            Click="RestartButton_Click" />
                    <Button x:Name="StatusButton" Content="CHECK STATUS" Tag="Poll now"
                            Click="StatusButton_Click" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Rectangle Style="{StaticResource SectionAxeStyle}" />
                    <TextBlock Text="BACKUP" Style="{StaticResource SectionHeaderStyle}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource DividerStyle}" />
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Button x:Name="BackupButton" Content="MANUAL BACKUP" Tag="Snapshot world"
                            Margin="0,0,10,0" Click="BackupButton_Click" />
                    <Button x:Name="BackupRestartButton" Content="BACKUP + RESTART" Tag="Snapshot, then cycle"
                            Margin="0,0,10,0" Click="BackupRestartButton_Click" />
                    <Button x:Name="LogsButton" Content="VIEW LOGS" Tag="Open full console"
                            Click="LogsButton_Click" />
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Rectangle Style="{StaticResource DangerAxeStyle}" />
                    <TextBlock Text="RAGNAROK" Style="{StaticResource DangerHeaderStyle}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource DangerDividerStyle}" />
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button x:Name="StopButton" Content="STOP" Tag="Halt the server"
                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0"
                            Click="StopButton_Click" />
                    <Button x:Name="CloseButton" Content="CLOSE" Tag="Leave the hall"
                            Style="{StaticResource GhostButtonStyle}" Click="CloseButton_Click" />
                </UniformGrid>
                <Button x:Name="BackupRebootButton" Content="BACKUP + REBOOT HOST" Tag="Stop, save, reboot"
                        Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch"
                        Margin="0,0,0,4" Click="BackupRebootButton_Click" />

                <ProgressBar x:Name="ActionProgress" Margin="0,22,0,0" IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ===== Saga log ===== -->
        <Border Grid.Row="2" Background="{StaticResource LogBgBrush}"
                BorderBrush="{StaticResource BorderMutedBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,16,22,20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="SAGA LOG" Style="{StaticResource SectionHeaderStyle}" FontSize="12" />
                    <TextBlock Text="tail · auto-scroll" Style="{StaticResource MonoTextStyle}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
                <TextBox x:Name="LogBox" Style="{StaticResource LogTextBoxStyle}"
                         Height="150" BorderThickness="0" Padding="0"
                         Background="Transparent" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
