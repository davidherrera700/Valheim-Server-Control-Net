<Window x:Class="ValheimControl.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Control — Account"
        Width="480" SizeToContent="Height"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Height="4" Background="{StaticResource ChevronBandBrush}" />
            <Border Background="{StaticResource BgTitleBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource SectionAxeStyle}" />
                    <TextBlock Text="ACCOUNT" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="24">

            <TextBlock Text="SIGNED IN AS" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
            <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,12" />
            <Border Background="{StaticResource BgTitleBrush}" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="UsernameText" Text="—" FontWeight="Bold" FontSize="15" />
                    <TextBlock x:Name="RoleText" Text=""
                               Style="{StaticResource SubtitleTextStyle}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="WHAT YOU CAN DO" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
            <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,12" />
            <StackPanel x:Name="PermissionsPanel" Margin="0,0,0,20" />

            <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource SectionHeaderStyle}" FontSize="13" />
            <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,12" />

            <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,4,0,12" />

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12" />

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <TextBlock x:Name="PasswordStatusText" Text="" VerticalAlignment="Center"
                           Style="{StaticResource SubtitleTextStyle}" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,12,0" />
                <Button x:Name="ChangePasswordButton" Content="UPDATE PASSWORD" Style="{StaticResource ChipButtonStyle}"
                        Click="ChangePasswordButton_Click" />
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ManageUsersButton" Content="MANAGE USERS &amp; ROLES" Style="{StaticResource ChipButtonStyle}"
                        BorderBrush="{StaticResource AccentGoldBrush}" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="ManageUsersButton_Click" />
                <Button x:Name="LogoutButton" Content="LOG OUT" Style="{StaticResource DangerButtonStyle}"
                        Click="LogoutButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
