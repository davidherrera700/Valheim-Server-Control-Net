<Window x:Class="ValheimControl.UsersRolesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Control — Manage Users &amp; Roles"
        Width="820" Height="640" MinWidth="720" MinHeight="520"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0">
            <Border Height="4" Background="{StaticResource ChevronBandBrush}" />
            <Border Background="{StaticResource BgTitleBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource SectionAxeStyle}" />
                        <TextBlock Text="MANAGE USERS &amp; ROLES" Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RolesViewButton" Content="ROLES" Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,8,0" Click="RolesViewButton_Click" />
                        <Button x:Name="UsersViewButton" Content="USERS" Style="{StaticResource ChipButtonStyle}"
                                Click="UsersViewButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Roles view ===== -->
        <Grid x:Name="RolesPanel" Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" x:Name="NewRoleButton" Content="+ NEW ROLE"
                        Style="{StaticResource ChipButtonStyle}" Margin="0,10,0,0" Click="NewRoleButton_Click" />
                <TextBlock DockPanel.Dock="Top" Text="ROLES" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                <ListBox x:Name="RoleList" SelectionChanged="RoleList_SelectionChanged" />
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="ROLE NAME" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="RoleNameBox" Margin="0,4,0,16" IsEnabled="False" />

                <TextBlock Text="PERMISSIONS" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                <StackPanel x:Name="PermissionsPanel" IsEnabled="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <TextBlock x:Name="RoleStatusText" Text="" VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextStyle}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,12,0" />
                    <Button x:Name="DeleteRoleButton" Content="DELETE ROLE" Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False" Margin="0,0,8,0" Click="DeleteRoleButton_Click" />
                    <Button x:Name="SaveRoleButton" Content="SAVE ROLE" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False" Click="SaveRoleButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Users view ===== -->
        <DockPanel x:Name="UsersPanel" Grid.Row="1" Margin="20" Visibility="Collapsed">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource BgTitleBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1"
                    Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="CREATE NEW USER" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="USERNAME"
                                   Style="{StaticResource SubtitleTextStyle}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="PASSWORD"
                                   Style="{StaticResource SubtitleTextStyle}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="ROLE"
                                   Style="{StaticResource SubtitleTextStyle}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />

                        <TextBox x:Name="NewUsernameBox" Grid.Row="1" Grid.Column="0" />
                        <PasswordBox x:Name="NewUserPasswordBox" Grid.Row="1" Grid.Column="2" />
                        <ComboBox x:Name="NewUserRoleBox" Grid.Row="1" Grid.Column="4" />
                        <Button Grid.Row="1" Grid.Column="6" Content="CREATE" Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom" Click="CreateUserButton_Click" />
                    </Grid>
                    <TextBlock x:Name="UserStatusText" Text="" Margin="0,8,0,0"
                               Style="{StaticResource SubtitleTextStyle}" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="USERS" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="UsersListPanel" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
