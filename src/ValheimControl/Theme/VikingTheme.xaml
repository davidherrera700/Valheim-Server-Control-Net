<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         VikingTheme.xaml — "Carved Longhall"
         Warm oak ground, brass accents, engraved serif titles.
         Replaces the earlier cool-grey palette wholesale.
         ===================================================================== -->

    <!-- ===================== Palette ===================== -->
    <Color x:Key="BgDarkColor">#16110C</Color>
    <Color x:Key="BgTitleColor">#1B1510</Color>
    <Color x:Key="BgPanelColor">#241C15</Color>
    <Color x:Key="BgPanelHoverColor">#2F251B</Color>
    <Color x:Key="BorderMutedColor">#3E3125</Color>
    <Color x:Key="BorderFaintColor">#241C15</Color>
    <Color x:Key="AccentGoldColor">#C9A876</Color>
    <Color x:Key="AccentGoldBrightColor">#E6C892</Color>
    <Color x:Key="TextPrimaryColor">#EDE3D0</Color>
    <Color x:Key="TextSecondaryColor">#9E9384</Color>
    <Color x:Key="TextMutedColor">#948B7C</Color>
    <Color x:Key="StatusOnlineColor">#7FB685</Color>
    <Color x:Key="StatusOfflineColor">#C1553B</Color>
    <Color x:Key="StatusOfflineTextColor">#E39176</Color>
    <Color x:Key="StatusWarningColor">#D9A441</Color>
    <Color x:Key="LogBgColor">#0F0B08</Color>
    <Color x:Key="LogTextColor">#C9D1D9</Color>

    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="BgTitleBrush" Color="{StaticResource BgTitleColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgPanelHoverBrush" Color="{StaticResource BgPanelHoverColor}" />
    <SolidColorBrush x:Key="BorderMutedBrush" Color="{StaticResource BorderMutedColor}" />
    <SolidColorBrush x:Key="BorderFaintBrush" Color="{StaticResource BorderFaintColor}" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />
    <SolidColorBrush x:Key="AccentGoldBrightBrush" Color="{StaticResource AccentGoldBrightColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnlineColor}" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOfflineColor}" />
    <SolidColorBrush x:Key="StatusOfflineTextBrush" Color="{StaticResource StatusOfflineTextColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="LogBgBrush" Color="{StaticResource LogBgColor}" />
    <SolidColorBrush x:Key="LogTextBrush" Color="{StaticResource LogTextColor}" />

    <!-- Fonts. Cambria and Segoe UI ship with Windows; Consolas is the log face.
         Cambria is the stand-in for the carved-serif look of the mockup. -->
    <FontFamily x:Key="TitleFont">Cambria</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- ===================== Ornament ===================== -->

    <!-- Gold hairline that fades at both ends — used under every section title. -->
    <LinearGradientBrush x:Key="RuneDividerBrush" StartPoint="0,0" EndPoint="1,0" Opacity="0.45">
        <GradientStop Color="Transparent" Offset="0" />
        <GradientStop Color="{StaticResource AccentGoldColor}" Offset="0.15" />
        <GradientStop Color="{StaticResource AccentGoldColor}" Offset="0.85" />
        <GradientStop Color="Transparent" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerDividerBrush" StartPoint="0,0" EndPoint="1,0" Opacity="0.55">
        <GradientStop Color="Transparent" Offset="0" />
        <GradientStop Color="{StaticResource StatusOfflineColor}" Offset="0.15" />
        <GradientStop Color="{StaticResource StatusOfflineColor}" Offset="0.85" />
        <GradientStop Color="Transparent" Offset="1" />
    </LinearGradientBrush>

    <!-- Tiled dash band that sits directly under the title bar. -->
    <DrawingBrush x:Key="ChevronBandBrush" TileMode="Tile" Viewport="0,0,16,4"
                  ViewportUnits="Absolute" Stretch="None" Opacity="0.28">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{DynamicResource AccentGoldBrush}">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,8,4" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== Imagery =====================
         All three assets are WHITE silhouettes on transparent PNG; the theme
         tints them by using the image as an OpacityMask over a solid fill, so
         one file serves both the gold and the red variants.
         Build action: Resource. Paths assume an Assets/ folder. -->

    <!-- Yggdrasil medallion behind the state column. Gold LINE ART (not a
         silhouette), so it survives at 18% rather than needing 8%. -->
    <ImageBrush x:Key="YggdrasilWatermarkBrush"
                ImageSource="pack://application:,,,/Assets/yggdrasil.png"
                Stretch="Uniform"
                AlignmentX="Center"
                AlignmentY="Center"
                Opacity="0.18" />

    <!-- Crossed axes: window header mark (also the app .ico). -->
    <Style x:Key="AppMarkStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Fill" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/Assets/axes-crossed.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Single axe before each section title. -->
    <Style x:Key="SectionAxeStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Fill" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/Assets/axe-single.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alternate header mark: swap this in for AppMarkStyle to run the
         hammer instead of the crossed axes. Same size, same slot. -->
    <Style x:Key="MjolnirMarkStyle" TargetType="Rectangle" BasedOn="{StaticResource AppMarkStyle}">
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/Assets/mjolnir-mark.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerAxeStyle" TargetType="Rectangle" BasedOn="{StaticResource SectionAxeStyle}">
        <Setter Property="Fill" Value="{StaticResource StatusOfflineBrush}" />
    </Style>

    <!-- Small rotated square used as a list bullet / status marker.
         Usage: <Rectangle Style="{StaticResource DiamondMarkerStyle}" /> -->
    <Style x:Key="DiamondMarkerStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="45" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Divider line. Usage: <Border Style="{StaticResource DividerStyle}" /> -->
    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource RuneDividerBrush}" />
        <Setter Property="Margin" Value="0,10,0,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DangerDividerStyle" TargetType="Border" BasedOn="{StaticResource DividerStyle}">
        <Setter Property="Background" Value="{StaticResource DangerDividerBrush}" />
    </Style>

    <!-- Card / panel container. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Text ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Section headers: SERVER / BACKUP / RAGNAROK -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
    </Style>

    <Style x:Key="DangerHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
        <Setter Property="Foreground" Value="{StaticResource StatusOfflineBrush}" />
    </Style>

    <!-- The big ONLINE / OFFLINE word. Foreground is set from code (AppTheme). -->
    <Style x:Key="StateTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource StatusOnlineBrush}" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}" />

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource LogTextBrush}" />
    </Style>

    <!-- ===================== Scrollbars ===================== -->
    <Style x:Key="ThemedScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{StaticResource BorderMutedBrush}"
                            CornerRadius="1" Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThemedScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- Default: panel fill, gold hairline, optional sub-label via Tag.
         <Button Content="MANUAL BACKUP" Tag="Snapshot world" /> -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="1"
                            SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center">
                            <ContentPresenter x:Name="MainContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <TextBlock x:Name="SubLabel"
                                       Text="{TemplateBinding Tag}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BgPanelHoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gold-edged: the two primary run actions (Start, Restart). -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
    </Style>

    <!-- Solid gold: one per window maximum (Save, Continue). -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrightBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BgDarkBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="24,11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Destructive: Stop, Backup + Reboot Host. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderBrush" Value="{StaticResource StatusOfflineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource StatusOfflineTextBrush}" />
    </Style>

    <!-- Quiet: Close, Cancel, Revert. -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BgTitleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,11" />
    </Style>

    <!-- Small chip used for row actions (Message / Kick) and log filters. -->
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Path / command fields read better in the mono face. -->
    <Style x:Key="MonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The log surface: darkest ground in the app, mono, read-only. -->
    <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource LogBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LogTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentGoldBrush}" />
    </Style>

    <!-- ===================== Toggle switch ===================== -->
    <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SwitchTrack" Background="{StaticResource BorderMutedBrush}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SwitchKnob" Width="16" Height="16" Margin="2"
                                HorizontalAlignment="Left"
                                Background="{StaticResource TextMutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchKnob" Property="Background" Value="{StaticResource BgDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tabs (Players, Config) ===================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource BgDarkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="Transparent" Padding="2,0,26,12"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Lists (players, files) ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="4,11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RowBorder" Background="Transparent"
                            BorderBrush="{StaticResource BorderFaintBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BgPanelBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BgPanelBrush}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox (settings dropdowns) ===================== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButtonPart"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="2" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <TextBlock Text="&#9662;"
                                   Foreground="{DynamicResource AccentGoldBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,10,0"
                                   IsHitTestVisible="False" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="{DynamicResource AccentGoldBrush}"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgPanelHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BgDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Progress (backup in flight) ===================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{StaticResource BorderFaintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderFaintBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===================== Info icon (small "?" with a tooltip) ===================== -->
    <Style x:Key="InfoIconStyle" TargetType="Border">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InfoIconTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="?" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
