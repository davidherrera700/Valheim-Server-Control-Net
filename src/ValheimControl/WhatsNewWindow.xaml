<Window x:Class="ValheimControl.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Width="460" SizeToContent="Height"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="What's New" Style="{StaticResource TitleTextStyle}" FontSize="18" />
            <Border Style="{StaticResource DividerStyle}" Margin="0,8,0,16" />

            <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,0,0,20" />

            <Border Background="{StaticResource BgTitleBrush}" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,18">
                <Grid>
                    <TextBlock Text="Don't show this again until the next update" VerticalAlignment="Center" />
                    <ToggleButton x:Name="DontShowAgainToggle" Style="{StaticResource SwitchToggleStyle}"
                                  HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="CLOSE" Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
