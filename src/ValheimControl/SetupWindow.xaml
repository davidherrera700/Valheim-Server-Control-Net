<Window x:Class="ValheimControl.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Control - First-Time Setup"
        Height="680" Width="480"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanResize"
        MinHeight="560" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VALHEIM SERVER CONTROL - SETUP" Style="{StaticResource TitleTextStyle}" FontSize="17" />

        <Border Grid.Row="1" Height="2" Background="{DynamicResource RuneDividerBrush}" Margin="0,8,0,4" />

        <TextBlock Grid.Row="2" Text="Connects this PC to your Ubuntu Valheim server over SSH."
                   Style="{StaticResource SubtitleTextStyle}" Margin="0,4,0,14" />

        <StackPanel Grid.Row="3">
            <TextBlock Text="SERVER IP OR HOSTNAME" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="ServerBox" Text="192.168.50.239" />

            <TextBlock Text="SSH USERNAME" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="UsernameBox" Text="valheim-control" />

            <TextBlock Text="SSH PORT" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="PortBox" Text="22" />

            <TextBlock Text="ACCOUNT PASSWORD (used once, never stored)" Style="{StaticResource FieldLabelStyle}" />
            <PasswordBox x:Name="PasswordBox" />

            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                <Button x:Name="InstallButton" Content="RUN SETUP" Click="InstallButton_Click" />
                <Button x:Name="ContinueButton" Content="CONTINUE TO APP"
                        Margin="10,4,4,4" IsEnabled="False" Click="ContinueButton_Click" />
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="4"
                 Style="{StaticResource LogTextBoxStyle}"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Margin="0,0,0,10" />

        <TextBlock Grid.Row="5" Style="{StaticResource SubtitleTextStyle}" FontSize="10"
                   Text="Requires the Windows OpenSSH Client optional feature for key generation (Settings &gt; Apps &gt; Optional Features)." />
    </Grid>
</Window>
