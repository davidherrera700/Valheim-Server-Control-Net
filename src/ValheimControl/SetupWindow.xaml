<Window x:Class="ValheimControl.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim Control - First-Time Setup"
        Height="560" Width="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Valheim Server Control - Setup" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Connects this PC to your Ubuntu Valheim server over SSH."
                       Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Server IP or hostname" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="ServerBox" />

            <TextBlock Text="SSH username" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="UsernameBox" Text="valheim-control" />

            <TextBlock Text="SSH port" Style="{StaticResource LabelStyle}" />
            <TextBox x:Name="PortBox" Text="22" />

            <TextBlock Text="Account password (used once, never stored)" Style="{StaticResource LabelStyle}" />
            <PasswordBox x:Name="PasswordBox" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,10">
            <Button x:Name="InstallButton" Content="Run Setup" Padding="14,8" Click="InstallButton_Click" />
            <Button x:Name="ContinueButton" Content="Continue to App" Padding="14,8" Margin="10,0,0,0"
                    IsEnabled="False" Click="ContinueButton_Click" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="3"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 Background="#1E1E1E" Foreground="#DCDCDC"
                 Padding="6" Margin="0,0,0,10" />

        <TextBlock Grid.Row="4" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Requires the Windows OpenSSH Client optional feature for key generation (Settings &gt; Apps &gt; Optional Features)." />
    </Grid>
</Window>
