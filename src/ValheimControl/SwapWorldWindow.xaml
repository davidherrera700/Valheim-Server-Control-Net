<Window x:Class="ValheimControl.SwapWorldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swap World"
        Width="440" SizeToContent="Height"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Swap World" Style="{StaticResource TitleTextStyle}" FontSize="18" />
            <TextBlock Text="Switches which world the server loads. Nothing is deleted - the current world's save stays right where it is."
                       Style="{StaticResource SubtitleTextStyle}" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,6,0,16" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Current world:" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" x:Name="CurrentWorldText" Text="—" Style="{StaticResource MonoTextStyle}" />
            </Grid>

            <TextBlock Text="SWAP TO" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4" />
            <ComboBox x:Name="WorldPicker" />

            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource SubtitleTextStyle}"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="SwapButton" Content="SWAP WORLD" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False" Click="SwapButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
