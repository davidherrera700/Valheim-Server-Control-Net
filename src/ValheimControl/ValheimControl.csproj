<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimControl</AssemblyName>
    <RootNamespace>ValheimControl</RootNamespace>

    <!-- Custom icon: Assets\valheim.ico -->
    <ApplicationIcon>Assets\valheim.ico</ApplicationIcon>

    <!-- Publish settings for a single, self-contained .exe -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- SSH.NET handles the SSH connection natively - no dependency on ssh.exe being on PATH -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Needed for 'dynamic' COM interop with WScript.Shell in ShortcutService -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\valheim.ico" Condition="Exists('Assets\valheim.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Theme ornament images, referenced via pack://application:,,,/Assets/... in
         VikingTheme.xaml. Build action must be Resource for those URIs to resolve. -->
    <Resource Include="Assets\yggdrasil.png" Condition="Exists('Assets\yggdrasil.png')" />
    <Resource Include="Assets\axes-crossed.png" Condition="Exists('Assets\axes-crossed.png')" />
    <Resource Include="Assets\axe-single.png" Condition="Exists('Assets\axe-single.png')" />
    <Resource Include="Assets\mjolnir-mark.png" Condition="Exists('Assets\mjolnir-mark.png')" />
  </ItemGroup>

</Project>
