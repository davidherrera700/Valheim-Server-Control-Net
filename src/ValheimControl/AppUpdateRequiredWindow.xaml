<Window x:Class="ValheimControl.AppUpdateRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Required"
        Width="480" SizeToContent="Height"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Height="4" Background="{StaticResource DangerDividerBrush}" />
            <Border Background="{StaticResource BgTitleBrush}"
                    BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource DangerAxeStyle}" />
                    <TextBlock Text="UPDATE REQUIRED" Style="{StaticResource DangerHeaderStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock TextWrapping="Wrap"
                       Text="This PC is running an older version of Valheim Control than the server expects. Since the app talks to shared scripts on the server, everyone needs to be on the same version to avoid confusing mismatches."
                       Margin="0,0,0,16" />

            <Border Background="{StaticResource BgTitleBrush}" BorderBrush="{StaticResource BorderMutedBrush}"
                    BorderThickness="1" Padding="14,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THIS PC" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="CurrentVersionText" Style="{StaticResource MonoTextStyle}" FontSize="16" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="REQUIRED" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="RequiredVersionText" Style="{StaticResource MonoTextStyle}" FontSize="16"
                                   Foreground="{StaticResource StatusOfflineTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap"
                       Style="{StaticResource SubtitleTextStyle}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,16" Visibility="Collapsed" />

            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Text=""
                       Style="{StaticResource SubtitleTextStyle}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,16" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExitButton" Content="EXIT" Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0" Click="ExitButton_Click" />
                <Button x:Name="ViewReleaseButton" Content="VIEW RELEASE" Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0" Click="ViewReleaseButton_Click" />
                <Button x:Name="UpdateNowButton" Content="UPDATE NOW" Style="{StaticResource DangerButtonStyle}"
                        Click="UpdateNowButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
