[Unit]
Description=Valheim Control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/valheim-control-api
ExecStart=/usr/bin/dotnet /opt/valheim-control-api/ValheimControlApi.dll
Restart=always
RestartSec=5

# Bound explicitly to two trusted addresses - the Tailscale interface
# and the server's local LAN IP - never 0.0.0.0, so this stays
# unreachable from the public internet regardless of firewall rules.
# The LAN address was added so PCs on the same local network (not on
# Tailscale) can reach the API too. Update either IP if they ever change.
Environment=ASPNETCORE_URLS=http://100.71.61.39:5080;http://192.168.50.239:5080
Environment=ASPNETCORE_ENVIRONMENT=Production

# The JWT signing key lives ONLY on the server, in a file that is never
# committed to git - see the "Rotating the JWT key" section in README.md
# for how to create it. Do NOT put the actual key value in this file;
# this file itself is tracked in source control.
EnvironmentFile=/etc/valheim-control-api.env

[Install]
WantedBy=multi-user.target
